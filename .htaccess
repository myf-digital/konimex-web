DirectoryIndex index.php

# Disable directory listing
Options -Indexes

# Block sensitive files and hidden dotfiles (.git, .env, package.json, composer.json, web.config, etc.)
<FilesMatch "(^\..*|\.(env|log|git|sql|bak|config|lock|yml|yaml|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

RewriteEngine on

# Prevent direct PHP execution in uploads and assets directory
RewriteRule ^(uploads|assets)/.*\.php[0-9]?$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [QSA,L]

RewriteCond %{HTTPS} off
RewriteRule ^.*$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#FcgidIOTimeout 300
